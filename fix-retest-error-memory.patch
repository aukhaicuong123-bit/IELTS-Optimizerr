+        </label>
+      </div>
+      {goalError && <p className="status">{goalError}</p>}
+      <button className="primary" onClick={save}>
+        Save profile
+      </button>
+      <button
+        className="danger-outline"
+        onClick={() => {
+          clearStore()
+          location.reload()
+        }}
+      >
+        Clear local data
+      </button>
+    </section>
+  )
+}
