+  goal <= 0 ? 0 : minutes <= 0 ? 0 : minutes / goal <= 0.25 ? 1 : minutes / goal <= 0.5 ? 2 : minutes / goal <= 0.75 ? 3 : minutes / goal < 1 ? 4 : 5
